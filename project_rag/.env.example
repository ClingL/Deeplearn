# ============================================================
# 多模态文档问答系统 (RAG) 环境变量示例
#
# 用法: 复制本文件为 .env, 然后填入自己的 key
#     Windows     :  copy .env.example .env
#     macOS/Linux :  cp .env.example .env
#
# .env 已经被 .gitignore 忽略, 不要把真实 key 提交到 GitHub。
# ============================================================


# ---------- 必填 1/3: 大模型 API Key ----------
LLM_API_KEY=sk-替换成你自己的key


# ---------- 必填 2/3: OpenAI 兼容接口的 base_url ----------
# 本项目统一用 OpenAI 官方 SDK 调用, 只要服务商提供 OpenAI 兼容接口都能用。
# 注意: 大多数服务商的 base_url 需要带 /v1 或 /v4 后缀, 写错会报 404。
#
#   DeepSeek (深度求索) : https://api.deepseek.com/v1
#   阿里百炼 (通义千问)  : https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM            : https://open.bigmodel.cn/api/paas/v4
#   Moonshot (Kimi)     : https://api.moonshot.cn/v1
#   OpenAI              : https://api.openai.com/v1
#   本地 Ollama         : http://localhost:11434/v1   (key 随便填, 例如 ollama)
LLM_BASE_URL=https://api.deepseek.com/v1


# ---------- 必填 3/3: 模型名 ----------
#   DeepSeek   : deepseek-chat
#   阿里百炼    : qwen-plus
#   智谱 GLM   : glm-4-flash
#   Moonshot   : moonshot-v1-8k
#   OpenAI     : gpt-4o-mini
#   Ollama     : qwen2.5:7b
LLM_MODEL=deepseek-chat


# ---------- 可选: 生成温度与超时 (秒) ----------
# 问答场景建议低温, 减少幻觉; 不填则默认 0.2 和 60
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
